{
  "name": "novanis",
  "private": true,
  "description": "convenient, fast, adaptive client for e-journal used in NIS",
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "start": "dotenv -- turbo run start",
    "build": "stale-dep && dotenv -- turbo run build",
    "dev": "stale-dep && dotenv -- turbo run dev",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "postinstall": "npx only-allow yarn && stale-dep -u && yarn build --filter @novanis/shared"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "resolutions": {
    "globals": "^17.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^7.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "prettier": "^3.6.2",
    "stale-dep": "^0.6.0",
    "turbo": "^2.10.0",
    "typescript-eslint": "^8.62.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
