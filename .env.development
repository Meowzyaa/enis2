# API:
PORT=4000
# Generate your own secrets locally - do NOT commit real values.
JWT_SECRET="change-me-in-local-env"
# CRYPT_KEY must be exactly 32 bytes (aes-256-gcm).
CRYPT_KEY="change_me_0000000000000000000000"
IPINFO_TOKEN="xXxXxXxXxXxXxX" # not required

# Some school SMS hosts serve broken TLS chains; set to 1 to skip
# verification for NIS fetches only (TLS stays verified everywhere else).
# NIS_INSECURE_TLS=1

# Comma-separated origin allowlist for CORS; unset = any origin.
# CORS_ORIGIN="https://your-deployment.example"

# WEB:
VITE_SERVER_URL="http://localhost:${PORT}"
